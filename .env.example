# Hospitable API Authentication (Required)
# Generate from Hospitable Dashboard -> Settings -> API Keys / Personal Access Tokens
HOSPITABLE_PAT=your_hospitable_pat_here

# Email / SMTP Configuration (Optional - for auto-delivering invoices to Melio)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
