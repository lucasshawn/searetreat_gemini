# Hospitable API Authentication (Required)
# Generate from Hospitable Dashboard -> Settings -> API Keys / Personal Access Tokens
HOSPITABLE_PAT=your_hospitable_pat_here

# Email / SMTP Configuration (Optional - for auto-delivering invoices to Melio & owner P&L summary)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=searetreatpa@gmail.com
SMTP_PASS=your_app_password_here

# Owner Inbox (Recipient for monthly P&L summary email report with CSV attachment)
OWNER_EMAIL=searetreatpa@gmail.com

